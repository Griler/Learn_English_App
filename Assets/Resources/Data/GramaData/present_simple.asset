  grammarPointID: present_simple
  rule: S + V(s/es)
  name: 
  description: "Th\xEC hi\u1EC7n t\u1EA1i \u0111\u01A1n di\u1EC5n t\u1EA3 th\xF3i
    quen, s\u1EF1 th\u1EADt ho\u1EB7c h\xE0nh \u0111\u1ED9ng x\u1EA3y ra th\u01B0\u1EDDng
    xuy\xEAn."
  examples:
  - grammarPointID: present_simple
    ruleText: S + V(s/es)
    sentence: She likes the park.
    translation: "C\xF4 \u1EA5y th\xEDch c\xF4ng vi\xEAn."
    conjugatedVerb: likes
  - grammarPointID: present_simple
    ruleText: S + V(s/es)
    sentence: He drinks coffee every morning.
    translation: "Anh \u1EA5y u\u1ED1ng c\xE0 ph\xEA m\u1ED7i s\xE1ng."
    conjugatedVerb: drinks
  - grammarPointID: present_simple
    ruleText: S + V(s/es)
    sentence: They work at a big company.
    translation: "H\u1ECD l\xE0m vi\u1EC7c t\u1EA1i m\u1ED9t c\xF4ng ty l\u1EDBn."
    conjugatedVerb: work
  - grammarPointID: present_simple
    ruleText: S + V(s/es)
    sentence: It rains a lot in the summer.
    translation: "Tr\u1EDDi m\u01B0a nhi\u1EC1u v\xE0o m\xF9a h\xE8."
    conjugatedVerb: rains
  - grammarPointID: present_simple
    ruleText: S + V(s/es)
    sentence: We play football on weekends.
    translation: "Ch\xFAng t\xF4i ch\u01A1i b\xF3ng \u0111\xE1 v\xE0o cu\u1ED1i tu\u1EA7n."
